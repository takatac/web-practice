---
import LeadForm from "./LeadForm.astro";
---

<aside class="follow-form" id="follow-form" aria-labelledby="follow-form-title">
  <button class="close" type="button" aria-label="閉じる">×</button>
  <h2 id="follow-form-title">資料ダウンロードフォーム</h2>
  <div class="banner">
    <p class="banner-tag">無料プレゼント</p>
    <p class="banner-copy">現場に合う安全対策が、<br />1冊でわかる。</p>
  </div>
  <div class="body">
    <LeadForm idPrefix="follow" />
  </div>
</aside>

<style>
  .follow-form {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 9999;
    width: calc(100% - 32px);
    max-width: 320px;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    background: var(--white);
    border: 1px solid var(--black);
    box-shadow: 0 4px 16px rgb(0 0 0 / 25%);
  }

  .follow-form.is-closed {
    display: none;
  }

  h2 {
    padding: 10px 36px;
    background: var(--black);
    color: var(--white);
    font-size: 15px;
    line-height: 1.5;
    text-align: center;
  }

  .close {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 1;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .close:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: -2px;
  }

  .banner {
    padding: 14px 16px;
    background: var(--gray-200);
  }

  .banner-tag {
    display: inline-block;
    padding: 2px 8px;
    background: var(--black);
    color: var(--white);
    font-size: 11px;
    font-weight: 700;
  }

  .banner-copy {
    margin-top: 6px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
  }

  .body {
    padding: 14px 16px 16px;
  }

  @media (max-width: 600px) {
    .follow-form {
      right: 8px;
      bottom: 8px;
      width: calc(100% - 16px);
      max-width: none;
      max-height: calc(100dvh - 88px);
    }
  }
</style>

<script>
  const STORAGE_KEY = "followFormClosed";
  const box = document.getElementById("follow-form");

  const readClosed = () => {
    try {
      return sessionStorage.getItem(STORAGE_KEY) === "1";
    } catch {
      return false;
    }
  };

  const announce = (closed: boolean) => {
    document.dispatchEvent(new CustomEvent("followform:change", { detail: { closed } }));
  };

  if (box) {
    if (readClosed()) box.classList.add("is-closed");

    box.querySelector(".close")?.addEventListener("click", () => {
      box.classList.add("is-closed");
      try {
        sessionStorage.setItem(STORAGE_KEY, "1");
      } catch {
        // 保存できなくても、このページでは閉じたままにする
      }
      announce(true);
    });
  }

  announce(!box || box.classList.contains("is-closed"));
</script>
