---
import Base from "../../layouts/Base.astro";
---

<Base
  title="ありがとうございました｜練習商事"
  description="資料請求の完了ページです（練習用）。"
  current="none"
  showFollowForm={false}
>
  <section class="section">
    <div class="wrap">
      <h1 class="page-title">ありがとうございました</h1>
      <p class="section-lead">
        資料番号 <strong id="doc-id">―</strong> の請求を受け付けた想定の画面です。練習用のため、入力内容はどこにも送信していません。
      </p>
    </div>
  </section>
</Base>

<style>
  .page-title {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.3;
  }
</style>

<script>
  const docId = new URLSearchParams(location.search).get("dl");
  const target = document.getElementById("doc-id");
  if (docId && target) target.textContent = docId;
</script>
