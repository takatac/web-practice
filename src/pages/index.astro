---
import Base from "../layouts/Base.astro";
import Slider from "../components/Slider.astro";

const slides = [
  { title: "屋根の点検（架空の例）", text: "点検の頻度が高い屋根に、作業の流れに合わせた備えを考えた例です。" },
  {
    title: "工場の改修（架空の例）",
    text: "改修中は作業場所が毎週変わります。場所が変わっても使い続けられるように、持ち運べる機器を中心に組み合わせ、使い方の説明も現場ごとに行った例です。",
  },
  { title: "倉庫の荷役（架空の例）", text: "荷の積み下ろしで危ない場所を、担当者と一緒に書き出した例です。" },
];
---

<Base
  title="練習商事｜現場の安全を支える専門商社"
  description="練習商事は、働く現場の安全を支える架空の専門商社です。"
  current="home"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">練習商事</p>
      <h1>現場の安全を、<br />もっと簡単に。</h1>
      <p class="lead">
        練習商事は、働く現場の安全を支える専門商社です。まず現場の困りごとをお聞かせください。
      </p>
      <a class="button" href="/safety/">労働安全の取り組みを見る</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>私たちにできること</h2>
      <p class="section-lead">製品を届けるだけでなく、選ぶ前と使い始めた後まで一緒に考えます。</p>
      <ul class="cards">
        <li>
          <h3>現場を見る</h3>
          <p>作業の流れと危ない場所を、担当者と一緒に確かめます。</p>
        </li>
        <li>
          <h3>合う物を選ぶ</h3>
          <p>現場の条件に合わせて、必要な機器を選んで提案します。</p>
        </li>
        <li>
          <h3>使い続けられるようにする</h3>
          <p>使い方の説明や点検の相談にも対応します。</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section tinted">
    <div class="wrap">
      <h2>導入事例</h2>
      <Slider slides={slides} />
    </div>
  </section>
</Base>
