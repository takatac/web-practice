---
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import Gallery from "../../components/Gallery.astro";

const faqItems = [
  {
    question: "現場を見てもらうだけでも相談できますか？",
    answer: "はい。製品が決まっていない段階でも、現場の困りごとを聞くところから始めます。",
  },
  {
    question: "小さな現場でも対応してもらえますか？",
    answer: "はい。現場の大きさにかかわらず、作業の内容に合わせて一緒に考えます。",
  },
  {
    question: "導入したあとの相談もできますか？",
    answer: "はい。使い方の説明や点検、現場が変わったときの見直しも相談できます。",
  },
];

const images = [
  { src: "/images/sample-1.svg", alt: "練習用の画像1" },
  { src: "/images/sample-2.svg", alt: "練習用の画像2" },
  { src: "/images/sample-3.svg", alt: "練習用の画像3" },
];

const steps = [
  { title: "危険を見つける", text: "現場を歩き、作業する人の話を聞いて、危ない場所と作業を書き出します。" },
  { title: "対策を決める", text: "危険そのものをなくせないかを先に考え、難しければ設備や保護具で備えます。" },
  { title: "使い方を伝える", text: "対策が現場で使われるよう、作業する人に手順と理由を説明します。" },
  { title: "続けて確かめる", text: "定期的に点検し、現場が変わったら対策も見直します。" },
];
---

<Base
  title="労働安全｜練習商事"
  description="練習商事の労働安全の取り組みを紹介します。"
  current="safety"
>
  <nav class="breadcrumb wrap" aria-label="パンくずリスト">
    <ol>
      <li><a href="/">トップ</a></li>
      <li aria-current="page">労働安全</li>
    </ol>
  </nav>

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">労働安全</p>
      <h1>安全は、現場を<br />知ることから。</h1>
      <p class="lead">
        同じ対策でも、現場が違えば合うとは限りません。作業の実態に合った安全を、一緒に考えます。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>重点を置く3つの分野</h2>
      <ul class="cards">
        <li>
          <h3>高所での作業</h3>
          <p>屋根や足場など、落ちる危険がある場所の備えを考えます。</p>
        </li>
        <li>
          <h3>有害物のある環境</h3>
          <p>粉じんや化学物質から、作業する人を守る方法を考えます。</p>
        </li>
        <li>
          <h3>現場の見守り</h3>
          <p>危ない状況に早く気づくための仕組みを考えます。</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section tinted">
    <div class="wrap">
      <h2>取り組みの進め方</h2>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="step-number">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>現場の写真</h2>
      <p class="section-lead">画像を押すと拡大します。</p>
      <Gallery images={images} />
    </div>
  </section>

  <section class="section tinted">
    <div class="wrap">
      <h2>よくある質問</h2>
      <Faq items={faqItems} />
    </div>
  </section>
</Base>
