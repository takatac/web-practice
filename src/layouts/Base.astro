---
interface Props {
  title: string;
  description: string;
  current: "home" | "safety";
}

const { title, description, current } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/">練習商事</a>
        <nav aria-label="メインメニュー">
          <a href="/" aria-current={current === "home" ? "page" : undefined}>トップ</a>
          <a href="/safety/" aria-current={current === "safety" ? "page" : undefined}>労働安全</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-name">練習商事</p>
        <p>このサイトは練習用です。練習商事は架空の会社です。</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --black: #111111;
    --gray-700: #4a4a4a;
    --gray-500: #6e6e6e;
    --gray-200: #d9d9d9;
    --gray-100: #f2f2f2;
    --white: #ffffff;
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--white);
    color: var(--black);
    font-family: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic", sans-serif;
    font-size: 17px;
    line-height: 1.8;
  }

  a {
    color: inherit;
  }

  a:focus-visible {
    outline: 2px solid var(--black);
    outline-offset: 3px;
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol {
    margin: 0;
  }

  .wrap {
    width: min(1040px, 100%);
    margin-inline: auto;
    padding-inline: 24px;
  }

  .site-header {
    border-bottom: 1px solid var(--gray-200);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }

  .logo {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 8px;
  }

  nav a {
    padding: 8px 12px;
    color: var(--gray-700);
    font-size: 15px;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--black);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  nav a[aria-current="page"] {
    color: var(--black);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .hero {
    padding-block: 96px;
    background: var(--black);
    color: var(--white);
  }

  .eyebrow {
    margin-bottom: 16px;
    color: var(--gray-200);
    font-size: 14px;
    letter-spacing: 0.12em;
  }

  .hero h1 {
    font-size: clamp(34px, 6vw, 60px);
    font-weight: 700;
    line-height: 1.3;
  }

  .hero .lead {
    max-width: 38em;
    margin-top: 24px;
    color: var(--gray-200);
  }

  .button {
    display: inline-block;
    margin-top: 40px;
    padding: 14px 28px;
    background: var(--white);
    color: var(--black);
    font-weight: 700;
    text-decoration: none;
  }

  .button:hover {
    background: var(--gray-200);
  }

  .hero .button:focus-visible {
    outline-color: var(--white);
  }

  .section {
    padding-block: 80px;
  }

  .section.tinted {
    background: var(--gray-100);
  }

  .section h2 {
    font-size: clamp(26px, 4vw, 34px);
    line-height: 1.4;
  }

  .section-lead {
    max-width: 38em;
    margin-top: 16px;
    color: var(--gray-700);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
    padding: 0;
    list-style: none;
  }

  .cards li {
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--gray-200);
  }

  .cards h3 {
    font-size: 19px;
  }

  .cards p {
    margin-top: 12px;
    color: var(--gray-700);
    font-size: 16px;
  }

  .steps {
    margin-top: 40px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--gray-200);
  }

  .steps li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding-block: 28px;
    border-bottom: 1px solid var(--gray-200);
  }

  .step-number {
    color: var(--gray-500);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
  }

  .steps h3 {
    font-size: 19px;
  }

  .steps p {
    margin-top: 8px;
    color: var(--gray-700);
    font-size: 16px;
  }

  .site-footer {
    padding-block: 40px;
    background: var(--gray-100);
    color: var(--gray-700);
    font-size: 14px;
  }

  .footer-name {
    margin-bottom: 4px;
    color: var(--black);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .hero {
      padding-block: 64px;
    }

    .section {
      padding-block: 56px;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .steps li {
      grid-template-columns: 48px 1fr;
    }
  }
</style>
